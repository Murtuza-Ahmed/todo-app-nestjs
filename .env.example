# Environment variables for the NestJS Todo App
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3000

# Database — the connection string is the single source of truth
# (Neon example: postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require)
DATABASE_URL=postgresql://user:password@host:5432/database
# Set true only for local dev. NEVER true in production — it can drop data.
DATABASE_SYNC=false
DATABASE_LOGGING=false

# JWT
JWT_KEY=change-me-to-a-long-random-secret
# Seconds ("3600") or duration string ("15m", "1h", "7d")
JWT_EXPIRES_IN=3600

# Admin seed (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# CORS: "*" or a comma-separated list of allowed origins
CORS_ORIGIN=*

# Observe (optional — app boots fine without these)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
