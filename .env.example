# Environment variables for the NestJS Todo App
PORT=4003

# Database configuration
DATABASE_URL=todo_app_nestjs
DATABASE_HOST=localhost
DATABASE_PORT=1234
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=admin

# Database synchronization and logging
DATABASE_SYNC=BOOLEAN
DATABASE_LOGGING=BOOLEAN

# JWT configuration
JWT_KEY=your_jwt_secret_key
JWT_EXPIRES_IN=3600

# Admin credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Abc@123

# Observe configuration
OBSERVE_APP_KEY='YOUR_OBSERVE_APP_KEY'
OBSERVE_APP_SECRET='YOUR_OBSERVE_APP_SECRET'